FIGMA_BRIDGE_TOKEN=replace-with-a-long-random-token
FIGMA_BRIDGE_PORT=3055
# Optional: only needed for REST tools, with file_content:read scope.
FIGMA_ACCESS_TOKEN=
# Remote MCP (npm run start:remote). Clients send "Authorization: Bearer <MCP_HTTP_TOKEN>".
MCP_HTTP_TOKEN=replace-with-a-long-random-token
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3100
# Optional: comma-separated Host headers to accept, e.g. figma.example.com
MCP_HTTP_ALLOWED_HOSTS=
